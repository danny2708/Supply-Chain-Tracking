{
  "services": [
    {
      "name": "web",
      "environment": {
        "PORT": "8000"
      },
      "startCommand": "gunicorn supplychain_backend.wsgi:application"
    },
    {
      "name": "queue-worker",
      "startCommand": "python manage.py process_queue",
      "isPublic": false
    },
    {
      "name": "listener-worker",
      "startCommand": "python manage.py listen_events",
      "isPublic": false
    }
  ],
  "build": {
    "builder": "nixpacks"
  }
}